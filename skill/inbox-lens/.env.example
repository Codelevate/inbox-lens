# Private Zoho Self Client credentials. Copy to .env only on your own computer.
# Never share this file, paste its values into an AI chat, or commit it to Git.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# The helper sets these for your Zoho region.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_BASE_URL=https://mail.zoho.com/api

# Optional: leave blank to let Inbox Lens discover one mailbox automatically.
ZOHO_ACCOUNT_ID=

# Keep this local to this skill folder.
ZOHO_TOKEN_FILE=.zoho_tokens.json
